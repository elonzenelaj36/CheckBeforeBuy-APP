# Check Before Buy — backend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# The Expo dev server / mobile app usually doesn't need CORS (native fetch),
# but the web build and local testing tools do.
CORS_ORIGIN=*

# ── MySQL ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=check_before_buy
DB_USER=check_before_buy_user
DB_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate a real secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── AI — product analysis (vision + structured JSON) ────────────────────────
# Backend calls Anthropic's Claude API (vision-capable) to analyze product
# photos. Get a key at https://console.anthropic.com/
# Leave AI_API_KEY empty to run in mock mode (clearly marked as such in
# every response) instead of failing.
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# ── AI — room visualization (image generation) ───────────────────────────
# No image-generation provider is wired up yet (see backend/README.md).
# Set these once you pick one; the backend already has the abstraction and
# API contract in place (services/imageGenerationService.js).
IMAGE_AI_PROVIDER=
IMAGE_AI_API_KEY=

# ── Uploads ───────────────────────────────────────────────────────────────
# Local folder used for uploaded/generated images in development.
UPLOAD_DIR=uploads
# Public base URL the mobile app uses to reach this server (used to build
# absolute image URLs in API responses).
PUBLIC_BASE_URL=http://localhost:5000
