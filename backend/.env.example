# Check Before Buy — backend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# The Expo dev server / mobile app usually doesn't need CORS (native fetch),
# but the web build and local testing tools do.
CORS_ORIGIN=*

# ── MySQL ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=check_before_buy
DB_USER=check_before_buy_user
DB_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate a real secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── AI — product analysis (vision + structured JSON) ────────────────────────
# Two providers are supported. AI_PROVIDER picks explicitly ('anthropic' or
# 'ollama'); if left empty, the backend uses anthropic when AI_API_KEY is
# set, otherwise defaults to the free local ollama path. If neither is
# reachable, every response falls back to a clearly-marked mock result
# instead of failing.
AI_PROVIDER=

# Anthropic Claude (vision-capable). Get a key at https://console.anthropic.com/
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# Local Ollama (free, no API key). Install Ollama, then:
#   ollama pull llama3.2-vision
#   ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

# ── AI — external product search ("where to find this") ─────────────────────
# Google Cloud Vision API key, used only for Web Detection: finding real
# pages that match a product photo, so the app can link out to them. We
# never scrape or store the results — see productMatchService.js. Leave
# empty to run in mock mode. Get a key at https://console.cloud.google.com/
# (enable the Cloud Vision API; free tier: 1,000 units/month).
VISION_API_KEY=

# ── AI — room visualization (image generation) ───────────────────────────
# No image-generation provider is wired up yet (see backend/README.md).
# Set these once you pick one; the backend already has the abstraction and
# API contract in place (services/imageGenerationService.js).
IMAGE_AI_PROVIDER=cloudflare
# Cloudflare API token with Workers AI permission (backend only)
IMAGE_AI_API_KEY=
# Cloudflare account id (dashboard -> account overview)
IMAGE_AI_ACCOUNT_ID=
IMAGE_AI_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# ── Product background removal (visualization layers) ──────────────────────
# Our Cloudflare Worker in backend/cutout-worker (Cloudflare Images,
# BiRefNet; free plan: 5,000 photos/month, commercial use OK). Deploy it
# first (see its README), then set the two CUTOUT_WORKER_* values.
BACKGROUND_REMOVAL_PROVIDER=cloudflare
# e.g. https://cbb-cutout.<your-subdomain>.workers.dev
CUTOUT_WORKER_URL=
# Same value as the Worker's CUTOUT_SECRET (wrangler secret put CUTOUT_SECRET)
CUTOUT_WORKER_SECRET=

# ── 3D furniture (image → 3D model) ──────────────────────────────────────
# Free Hugging Face access token (https://huggingface.co/settings/tokens,
# type "Read") — used to run TRELLIS.2 on its public Hugging Face Space.
# Backend only, never in the mobile app. Without it, products stay 2D.
# The free account's daily GPU quota allows only a few models per day.
HF_TOKEN=

# ── Uploads ───────────────────────────────────────────────────────────────
# Local folder used for uploaded/generated images in development.
UPLOAD_DIR=uploads
# Public base URL the mobile app uses to reach this server (used to build
# absolute image URLs in API responses).
PUBLIC_BASE_URL=http://localhost:5000

# Web product search (SerpApi, https://serpapi.com) — backend only, never in the mobile app
SEARCH_PROVIDER=serpapi
SEARCH_API_KEY=
